  // POST /api/bible/sermons - Create sermon
  router.post('/sermons', (req: Request, res: Response) => {
    const { title, speaker, series, scriptureRef, description, mediaType, mediaUrl, duration, dateRecorded } = req.body;

    if (!title) {
      return res.status(400).json({ error: 'Title is required' });
    }

    try {
      const sermon = db.createSermon(title, speaker, series, scriptureRef, description, mediaType, mediaUrl, duration, dateRecorded);
      res.status(201).json(sermon);
    } catch (error) {
      res.status(500).json({ error: 'Failed to create sermon' });
